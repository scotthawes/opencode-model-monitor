{
  "name": "opencode-model-monitor",
  "version": "0.8.0",
  "description": "Passive monitoring microservice for OpenCode hosted (opencode-go) models: pricing changes, usage/quota, and agent config pins. Observation only — never intervenes in a session.",
  "type": "commonjs",
  "main": "src/monitor.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "monitor": "node src/monitor.js",
    "monitor:once": "node src/monitor.js --once",
    "report": "node src/report-cli.js",
    "report:history": "node src/report-cli.js --history",
    "history:html": "node src/history-view.js",
    "publish:snapshot": "node scripts/publish-snapshot.js",
    "calc": "node src/calc.js",
    "add-webhook": "node scripts/add-webhook.js"
  },
  "keywords": [
    "opencode",
    "model-monitor",
    "budget",
    "pricing",
    "usage",
    "monitoring"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  }
}
